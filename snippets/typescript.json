  "useQuery Hook": {
    "prefix": "useq",
    "body": [
      "import { queryOptions, useQuery } from \"@tanstack/react-query\";",
      "",
      "export type ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams = {${1}};",
      "",
      "export const ${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryKey = (params?: ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams) => [\"__query__\", \"${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}\", params];",
      "",
      "export const ${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryOptions = (params?: ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams) =>",
      "  queryOptions({",
      "    queryKey: ${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryKey(params),",
      "    queryFn: async () => {",
      "      return ${2:[]};",
      "    },",
      "  });",
      "",
      "type ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryOptions = Partial<ReturnType<typeof ${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryOptions>>;",
      "",
      "export function ${TM_FILENAME_BASE}(params?: ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams, options?: ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryOptions) {",
      "  return useQuery({ ...${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryOptions(params), ...options });",
      "}",
      ""
    ],
    "description": "useQuery hook"
  },
  "useInfiniteQuery Hook": {
    "prefix": "useiq",
    "body": [
      "import { useInfiniteQuery } from \"@tanstack/react-query\";",
      "",
      "export type ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams = {${1}};",
      "",
      "export const ${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryKey = (params: ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams) => [\"__infinite_query__\", \"${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}\", params];",
      "",
      "export function ${TM_FILENAME_BASE}(params: ${TM_FILENAME_BASE/use(.+)Query/${1}/}QueryParams) {",
      "  return useInfiniteQuery({",
      "    initialPageParam: {",
      "      page: 1,",
      "      size: 10,",
      "      hasNext: true",
      "    },",
      "    staleTime: 0,",
      "    queryKey: ${TM_FILENAME_BASE/use(.+)Query/${1:/camelcase}/}QueryKey(params),",
      "    queryFn: async ctx => {",
      "      const { data, total } = await ${2:Promise.resolve({ data: [], total: 0 }});",
      "      const hasNext = ctx.pageParam.page * ctx.pageParam.size < total;",
      "      return {",
      "        hasNext,",
      "        page: ctx.pageParam.page,",
      "        size: ctx.pageParam.size,",
      "        data",
      "      };",
      "    },",
      "    getNextPageParam: lastPage =>",
      "      lastPage.hasNext ? { ...lastPage, page: lastPage.page + 1 } : undefined",
      "  });",
      "}"
    ],
    "description": "useInfiniteQuery hook"
  },
  "useMutation Hook": {
    "prefix": "usem",
    "body": [
      "import { useMutation } from \"@tanstack/react-query\";",
      "",
      "export const ${TM_FILENAME_BASE/use(.+)Mutation/${1:/camelcase}/}MutationKey = () => [\"__mutation__\", \"${TM_FILENAME_BASE/use(.+)Mutation/${1:/camelcase}/}\"];",
      "",
      "export function ${TM_FILENAME_BASE}() {",
      "  return useMutation({",
      "    mutationKey: ${TM_FILENAME_BASE/use(.+)Mutation/${1:/camelcase}/}MutationKey(),",
      "    mutationFn: async (variables: { ${1} }) => {",
      "      return ${2:new Promise(resolve => {setTimeout(resolve, 500)}});",
      "    },",
      "  });",
      "}"
    ],
    "description": "useMutation hook"
  },
