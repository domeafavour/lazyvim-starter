      "  return request<${TM_CURRENT_LINE/([^\\.]+)\\.ar/${1:/capitalize}/}Params, ${TM_CURRENT_LINE/([^\\.]+)\\.ar/${1:/capitalize}/}Response>('${1}', {",
      "    method: '${2|POST,GET|}',",
      "    data",
      "  });",
      "};",
      ""
    ],
    "description": "Api Request"
  },
